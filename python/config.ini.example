# ============================================================
# 微信 AI 机器人 · 回复范围配置（示例模板）
# 复制为 config.ini 后按需修改（config.ini 已被 git 忽略，不会上传）
# ============================================================

[reply]

# 好友白名单：只自动回复这些好友（用逗号分隔，填微信里显示的名字/备注名）
# 留空 = 回复所有私聊好友
friends =

# 是否回复群消息：true = 开，false = 关（默认关，降低风控风险）
groups = false

# 群白名单：开启 groups 后，只回复这些群（用逗号分隔）
# 留空 = 回复所有群
group_names =

# 跳过这些会话（不读取也不回复，逗号分隔）：
# 用于绕过“一读就卡死/无限重试”的会话，比如 文件传输助手
skip_chats =
